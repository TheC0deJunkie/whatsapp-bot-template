# Server
PORT=3000
NODE_ENV=development

# ── Dev-only opt-ins (BOTH require NODE_ENV != production; ignored in prod) ──
# ENABLE_DEBUG_ROUTES — mount /debug/viewer, /debug/log and /debug/simulator.
#   These expose every message body and drive the bot engine unauthenticated,
#   so they are OFF unless this is the literal string "true". Never set in prod.
# TWILIO_SKIP_WEBHOOK_VALIDATION — skip the X-Twilio-Signature / Meta
#   X-Hub-Signature-256 HMAC check on /webhook. Needed for the local simulator
#   (it posts unsigned fake webhooks). Never set in prod — production ALWAYS
#   validates regardless.
ENABLE_DEBUG_ROUTES=false
TWILIO_SKIP_WEBHOOK_VALIDATION=false

# Database (Prisma, Postgres)
# Format: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://user:pass@host-pooler.region.example.com/dbname?sslmode=require"

# Messaging provider: 'twilio' (default) or 'meta'
WHATSAPP_PROVIDER=twilio

# Twilio (WhatsApp sender)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_API_KEY_SID=SKxxxxx
TWILIO_API_KEY_SECRET=your_secret
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=+10000000000
WEBHOOK_BASE_URL=https://your-domain.example.com

# Twilio Shared Sandbox (optional — enables dual-sender routing on the same
# webhook). Leave blank in prod-only setups. When set, inbound messages to this
# number get replied to from this number.
TWILIO_WHATSAPP_SANDBOX_FROM=
TWILIO_SANDBOX_JOIN_CODE=

# Meta WhatsApp Cloud API (only when WHATSAPP_PROVIDER=meta)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Default country code for normalizing local-format numbers (no + prefix).
DEFAULT_COUNTRY_CODE=1

# Fallback IANA timezone for users with no User.timezone set.
DEFAULT_TIMEZONE=UTC

# Shared secret protecting /api/cron-tick. Required in prod. Sent as
# `Authorization: Bearer <CRON_SECRET>` by Vercel platform Cron and any
# external trigger. Generate with: openssl rand -base64 32
CRON_SECRET=

# Sentry (optional — error telemetry is a no-op when unset)
SENTRY_DSN=
