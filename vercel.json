{
  "buildCommand": "node build.mjs",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/webhook", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/debug/:path*", "destination": "/api/index" }
  ]
}
